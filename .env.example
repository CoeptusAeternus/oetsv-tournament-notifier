# SMTP Configuration
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password

# Email Recipients (comma-separated)
RECIPIENTS=recipient1@example.com,recipient2@example.com

# API Configuration
API_URL=https://api.example.com/tournaments

# Notified Tournaments File
NOTIFIED_PATH=./notified.txt

# Nennschluss Notification (days before tournament)
DAYS_BEFORE_TOURNAMENT=13